# --- Secrets (required) ---
DISCORD_BOT_TOKEN=
# Channel to analyse for bug reports (required).
# (DISCORD_CHANNEL_ID is still accepted as an alias for this.)
DISCORD_SOURCE_CHANNEL_ID=
# Channel to post approval proposals + run summaries to (optional; defaults to source).
DISCORD_REVIEW_CHANNEL_ID=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# --- State backend (committed file in GITHUB_REPO via Contents API) ---
# Path of the state file in the repo (default: .argus/state.json)
ARGUS_STATE_PATH=.argus/state.json
# Optional: commit state to a dedicated branch to keep main history clean
ARGUS_STATE_BRANCH=

# --- Behaviour (optional; defaults shown) ---
ARGUS_MODEL=claude-opus-4-8
ARGUS_MAX_MESSAGES=500
ARGUS_REQUIRE_APPROVAL=true
# reporters | anyone | comma-separated Discord user IDs
ARGUS_APPROVERS=reporters
ARGUS_PROPOSAL_TTL_HOURS=72
ARGUS_SILENT_WHEN_EMPTY=false

# --- Logging (optional) ---
# debug | info | warn | error
ARGUS_LOG_LEVEL=info
