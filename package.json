{
  "name": "argus",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bug-reports watcher that distils messages into GitHub issues with Claude.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dry-run": "tsx src/index.ts --dry-run",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@discordjs/rest": "^2.4.0",
    "@octokit/rest": "^21.0.2",
    "discord-api-types": "^0.37.100",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0"
  }
}
